<li class="pub" id="{{ pub.key }}">
  {%- if pub.image %}
  <div class="pub-thumb"><img src="/{{ pub.image }}" alt="" eleventy:widths="240,480" sizes="120px"></div>
  {%- endif %}
  <div class="pub-body">
    <p class="pub-title"><span class="pub-label">{{ pub.label }}</span> {{ pub.title | escape }}</p>
    <p class="pub-authors">{% for a in pub.authors %}{% if a == site.author %}<strong>{{ a | escape }}</strong>{% else %}{{ a | escape }}{% endif %}{% unless forloop.last %}, {% endunless %}{% endfor %}</p>
    <p class="pub-venue"><em>{{ pub.venue | escape }}</em>, {{ pub.year }}{% if pub.award %} · <span class="award">{{ pub.award | escape }}</span>{% endif %}</p>
    <p class="links">
      {%- if pub.abstract %}
      <button type="button" class="toggle" aria-expanded="false" aria-controls="abs-{{ pub.key }}">abstract</button>
      {%- endif %}
      <button type="button" class="toggle" aria-expanded="false" aria-controls="cite-{{ pub.key }}">bibtex</button>
      {%- for link in pub.links %}
      <a href="{{ link.url }}">{{ link.label }}</a>
      {%- endfor %}
    </p>
    {%- if pub.abstract %}
    <div class="panel" id="abs-{{ pub.key }}" hidden><p>{{ pub.abstract | escape }}</p></div>
    {%- endif %}
    <div class="panel" id="cite-{{ pub.key }}" hidden>{% include "partials/bibtex.liquid", pub: pub %}</div>
  </div>
</li>
